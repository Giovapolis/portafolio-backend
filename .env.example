# Backend Environment Variables
# Copy to .env and update values

# Database
# For Docker: hostname is "postgres" (service name)
# For local dev: hostname is "localhost"
DATABASE_URL=postgresql://cv_user:CHANGE_ME@localhost:5432/portafolio

# JWT
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY
ALGORITHM=HS256

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=3600
